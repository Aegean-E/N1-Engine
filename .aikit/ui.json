{
  "schema": 1,
  "surfaces": {
    "app": {
      "paths": [
        "main/gui/**",
        "run_gui.py",
        "requirements.txt"
      ]
    }
  },
  "protected": [
    "tests/**"
  ],
  "commands": {
    "fast": "python -m pytest tests",
    "snapshot": ""
  },
  "style": {
    "theme_paths": []
  },
  "limits": {
    "max_files": 12,
    "max_lines": 300
  }
}
